# Local-only defaults for PI-P25-SCANNER MSYS2-to-Pi helper scripts.
# Copy this to .env or let the helper prompt once and create .env for you.
# Do not commit .env.
PI_USER=pi
PI_HOST=PI-SDR
PI_REPO=/home/pi/PI-P25-SCANNER
LOCAL_DOWNLOAD_DIR=/c/Users/jim/Downloads/pi-p25-command-logs
# PI_PASSWORD=your-pi-password-here

# Split-host deployment. ROC credentials may differ from the radio Pi.
ROC_USER=pi
ROC_HOST=roc.example.internal
ROC_REPO=/home/pi/sdrdev/N0JCG-ROC
# ROC_PASSWORD=your-roc-password-here

# Radio node ownership remains on the RTL/decoder Pi.
RADIO_USER=pi
RADIO_HOST=radio.example.internal
RADIO_REPO=/home/pi/PI-P25-SCANNER
# RADIO_PASSWORD=your-radio-pi-password-here
PI_SCANNER_RADIO_API_URL=http://radio.example.internal:8070
PI_SCANNER_RADIO_AUDIO_URL=http://radio.example.internal:8072
