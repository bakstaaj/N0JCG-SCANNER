async function saveConfig(config = null) {
  try {
    const payload = config || buildConfigFromForm();
    const response = await fetchJson('/api/config/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ config: payload }) });
    currentConfig = payload;
    setText('lastEvent', `Saved config: ${response.config_path}`);
    await refreshConfig();
refreshNamedConfigs();
    await refreshStatus();
    return response;
  } catch (error) {
    setText('lastEvent', `Save error: ${error.message}`);
    throw error;
  }
}

function defaultNamedConfigName() {
  const systemName = field('systemName')?.value?.trim();
  const siteName = field('siteName')?.value?.trim();
  if (systemName && siteName) return `${systemName} - ${siteName}`;
  if (systemName) return systemName;
  return 'Local P25 Config';
}

function renderNamedConfigChoices(configs) {
  namedConfigs = Array.isArray(configs) ? configs : [];
  const select = field('namedConfigSelect');
  if (!select) return;
  const previous = select.value;
  select.innerHTML = '';
  if (!namedConfigs.length) {
    const option = document.createElement('option');
    option.value = '';
    option.textContent = 'No saved configs yet';
    select.append(option);
    select.disabled = true;
    return;
  }
  select.disabled = false;
  namedConfigs.forEach((config) => {
    const option = document.createElement('option');
    option.value = config.id;
    const name = config.name || config.system_name || config.id;
    const site = config.site ? ` — ${config.site}` : '';
    const tgCount = Number.isFinite(Number(config.talkgroup_count)) ? ` (${config.talkgroup_count} TGIDs)` : '';
    option.textContent = `${name}${site}${tgCount}`;
    if (config.valid === false) option.textContent = `${name} — INVALID`;
    select.append(option);
  });
  if (previous && namedConfigs.some((config) => config.id === previous)) select.value = previous;
}

