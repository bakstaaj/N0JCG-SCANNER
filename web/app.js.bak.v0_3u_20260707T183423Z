// V04G2_NAMED_CONFIG_RECOVERY: robust named local config controls.
(function installNamedConfigRecovery() {
  const marker = 'V04G2_NAMED_CONFIG_RECOVERY';
  function q(id) { return document.getElementById(id); }
  function setNamedStatus(message) {
    const target = q('namedConfigStatus');
    if (target) target.textContent = message;
  }
  async function namedFetchJson(url, options = {}) {
    const response = await fetch(url, { cache: 'no-store', ...options });
    const text = await response.text();
    let payload = {};
    try { payload = text ? JSON.parse(text) : {}; }
    catch (error) { payload = { ok: false, error: `Invalid JSON: ${error.message}`, raw: text }; }
    if (!response.ok) throw new Error(payload.error || `HTTP ${response.status}`);
    return payload;
  }
  function fillNamedSelect(configs) {
    const select = q('namedConfigSelect');
    if (!select) return;
    const previous = select.value;
    select.innerHTML = '';
    const list = Array.isArray(configs) ? configs : [];
    if (!list.length) {
      const option = document.createElement('option');
      option.value = '';
      option.textContent = 'No saved configs yet';
      select.append(option);
      select.disabled = true;
      return;
    }
    select.disabled = false;
    list.forEach((config) => {
      const option = document.createElement('option');
      option.value = config.id || config.name || '';
      const name = config.name || config.id || 'Unnamed config';
      const site = config.site ? ` — ${config.site}` : '';
      const tgCount = Number.isFinite(Number(config.talkgroup_count)) ? ` (${config.talkgroup_count} TGIDs)` : '';
      option.textContent = config.valid === false ? `${name} — INVALID` : `${name}${site}${tgCount}`;
      select.append(option);
    });
    if (previous && list.some((config) => config.id === previous)) select.value = previous;
  }
  async function refreshNamedConfigList() {
    try {
      const response = await namedFetchJson('/api/config/named');
      fillNamedSelect(response.configs || []);
      setNamedStatus(`${(response.configs || []).length} saved config(s) available.`);
    } catch (error) {
      setNamedStatus(`Named config list error: ${error.message}`);
    }
  }
  async function currentConfigForNamedSave() {
    try {
      if (typeof buildConfigFromForm === 'function') return buildConfigFromForm();
    } catch (error) {
      setNamedStatus(`Form config build failed; using active config: ${error.message}`);
    }
    const response = await namedFetchJson('/api/config');
    if (!response.config) throw new Error('active config is not available');
    return response.config;
  }
  function defaultNamedConfigName() {
    const fromInput = q('namedConfigName')?.value?.trim();
    if (fromInput) return fromInput;
    const systemName = q('systemName')?.value?.trim();
    const siteName = q('siteName')?.value?.trim();
    if (systemName && siteName) return `${systemName} - ${siteName}`;
    if (systemName) return systemName;
    return 'Local P25 Config';
  }
  async function saveNamedConfigFromUi() {
    const name = defaultNamedConfigName();
    const input = q('namedConfigName');
    if (input && !input.value.trim()) input.value = name;
    try {
      const config = await currentConfigForNamedSave();
      const response = await namedFetchJson('/api/config/save-named', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, config, apply: false }),
      });
      fillNamedSelect(response.configs || []);
      const select = q('namedConfigSelect');
      if (select && response.id) select.value = response.id;
      setNamedStatus(`Saved named config: ${response.name || name}`);
    } catch (error) {
      setNamedStatus(`Save named config failed: ${error.message}`);
    }
  }
  async function loadSelectedNamedConfig() {
    const select = q('namedConfigSelect');
    const id = select?.value || '';
    if (!id) { setNamedStatus('Select a saved config first.'); return; }
    try {
      const response = await namedFetchJson('/api/config/load-named', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id }),
      });
      fillNamedSelect(response.configs || []);
      if (typeof refreshConfig === 'function') await refreshConfig();
      if (typeof refreshStatus === 'function') await refreshStatus();
      setNamedStatus(`Loaded named config: ${response.id || id}. OP25 config regenerated.`);
    } catch (error) {
      setNamedStatus(`Load named config failed: ${error.message}`);
    }
  }
  async function deleteSelectedNamedConfig() {
    const select = q('namedConfigSelect');
    const id = select?.value || '';
    if (!id) { setNamedStatus('Select a saved config first.'); return; }
    try {
      const response = await namedFetchJson('/api/config/delete-named', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id }),
      });
      fillNamedSelect(response.configs || []);
      setNamedStatus(`Deleted named config: ${response.id || id}`);
    } catch (error) {
      setNamedStatus(`Delete named config failed: ${error.message}`);
    }
  }
  function attachNamedConfigHandlers() {
    q('refreshNamedConfigsBtn')?.addEventListener('click', refreshNamedConfigList);
    q('saveNamedConfigBtn')?.addEventListener('click', saveNamedConfigFromUi);
    q('loadNamedConfigBtn')?.addEventListener('click', loadSelectedNamedConfig);
    q('deleteNamedConfigBtn')?.addEventListener('click', deleteSelectedNamedConfig);
    refreshNamedConfigList();
    console.log(marker, 'installed');
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attachNamedConfigHandlers, { once: true });
  } else {
    attachNamedConfigHandlers();
  }
}());

// NAMED_CONFIG_DYNAMIC_PANEL_V0_4G3
(function namedConfigDynamicPanelV04G3() {
  function byId(id) { return document.getElementById(id); }

  async function namedApiJson(url, options = {}) {
    if (typeof fetchJson === 'function') {
      return fetchJson(url, options);
    }
    const response = await fetch(url, { cache: 'no-store', ...options });
    const text = await response.text();
    const payload = text ? JSON.parse(text) : {};
    if (!response.ok) throw new Error(payload.error || `HTTP ${response.status}`);
    return payload;
  }

  function setNamedStatus(message) {
    const target = byId('namedConfigStatus');
    if (target) target.textContent = message || '';
  }

  function ensureNamedConfigPanel() {
    if (byId('namedConfigPanel')) return true;
    const screen = byId('configScreen');
    if (!screen) return false;

    const panel = document.createElement('section');
    panel.id = 'namedConfigPanel';
    panel.className = 'named-config-panel';
    panel.innerHTML = `
      <div class="named-config-head">
        <div>
          <h2>Saved Local Configs</h2>
          <p>Save the current scanner setup as a named Pi-local profile, then load it from the dropdown later.</p>
        </div>
      </div>
      <div class="named-config-grid">
        <label>Saved Configs
          <select id="namedConfigSelect"></select>
        </label>
        <label>Save Current As
          <input id="namedConfigName" type="text" placeholder="Mesa Fire Working" autocomplete="off">
        </label>
      </div>
      <div class="named-config-actions">
        <button id="refreshNamedConfigsBtn" type="button">Refresh List</button>
        <button id="loadNamedConfigBtn" type="button">Load Selected</button>
        <button id="saveNamedConfigBtn" type="button" class="primary">Save Named</button>
        <button id="deleteNamedConfigBtn" type="button" class="danger-lite">Delete</button>
      </div>
      <p id="namedConfigStatus" class="hint">Named configs are stored on the Pi under runtime/settings/configs/.</p>
    `;

    const anchor = screen.querySelector('.config-actions') || screen.querySelector('form') || screen.firstElementChild;
    if (anchor && anchor.parentNode === screen) {
      screen.insertBefore(panel, anchor);
    } else {
      screen.prepend(panel);
    }
    return true;
  }

  function selectedNamedConfigName() {
    const select = byId('namedConfigSelect');
    return String(select?.value || '').trim();
  }

  async function refreshNamedConfigs() {
    ensureNamedConfigPanel();
    const select = byId('namedConfigSelect');
    if (!select) return;
    try {
      const data = await namedApiJson('/api/config/named');
      const configs = Array.isArray(data.configs) ? data.configs : [];
      select.innerHTML = '';
      if (!configs.length) {
        const option = document.createElement('option');
        option.value = '';
        option.textContent = 'No saved configs yet';
        select.append(option);
        setNamedStatus('No named configs saved yet. Enter a name and tap Save Named.');
        return;
      }
      configs.forEach((config) => {
        const option = document.createElement('option');
        option.value = config.name || config.filename || '';
        const system = config.system_name ? ` — ${config.system_name}` : '';
        const site = config.site ? ` / ${config.site}` : '';
        const validity = config.valid === false ? ' (invalid)' : '';
        option.textContent = `${config.name || config.filename}${system}${site}${validity}`;
        select.append(option);
      });
      setNamedStatus(`Loaded ${configs.length} named config${configs.length === 1 ? '' : 's'}.`);
    } catch (error) {
      setNamedStatus(`Named config list failed: ${error.message}`);
    }
  }

  async function activeConfigPayload() {
    if (typeof currentConfig !== 'undefined' && currentConfig) return currentConfig;
    const response = await namedApiJson('/api/config');
    if (!response.config) throw new Error(response.error || 'active config is not available');
    return response.config;
  }

  async function saveNamedConfigFromUi() {
    const name = String(byId('namedConfigName')?.value || '').trim();
    if (!name) {
      setNamedStatus('Enter a name in Save Current As first.');
      return;
    }
    try {
      const config = await activeConfigPayload();
      await namedApiJson('/api/config/named/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, config }),
      });
      setNamedStatus(`Saved named config: ${name}`);
      await refreshNamedConfigs();
      const select = byId('namedConfigSelect');
      if (select) select.value = name;
    } catch (error) {
      setNamedStatus(`Save named config failed: ${error.message}`);
    }
  }

  async function loadNamedConfigFromUi() {
    const name = selectedNamedConfigName();
    if (!name) {
      setNamedStatus('Choose a saved config first.');
      return;
    }
    try {
      await namedApiJson('/api/config/named/load', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name }),
      });
      setNamedStatus(`Loaded named config: ${name}`);
      if (typeof refreshConfig === 'function') await refreshConfig();
      if (typeof refreshStatus === 'function') await refreshStatus();
      if (typeof showScreen === 'function') showScreen('dashboardScreen');
    } catch (error) {
      setNamedStatus(`Load named config failed: ${error.message}`);
    }
  }

  async function deleteNamedConfigFromUi() {
    const name = selectedNamedConfigName();
    if (!name) {
      setNamedStatus('Choose a saved config first.');
      return;
    }
    try {
      await namedApiJson('/api/config/named/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name }),
      });
      setNamedStatus(`Deleted named config: ${name}`);
      await refreshNamedConfigs();
    } catch (error) {
      setNamedStatus(`Delete named config failed: ${error.message}`);
    }
  }

  function attachNamedConfigHandlers() {
    if (!ensureNamedConfigPanel()) return;
    byId('refreshNamedConfigsBtn')?.addEventListener('click', refreshNamedConfigs);
    byId('saveNamedConfigBtn')?.addEventListener('click', saveNamedConfigFromUi);
    byId('loadNamedConfigBtn')?.addEventListener('click', loadNamedConfigFromUi);
    byId('deleteNamedConfigBtn')?.addEventListener('click', deleteNamedConfigFromUi);
    refreshNamedConfigs();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attachNamedConfigHandlers);
  } else {
    attachNamedConfigHandlers();
  }
})();
