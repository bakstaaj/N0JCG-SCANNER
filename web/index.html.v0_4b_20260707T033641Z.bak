<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title>PI P25 Scanner</title>
  <link rel="stylesheet" href="/app.css">
</head>
<body>
  <div class="app-shell">
    <header class="topbar">
      <button id="menuBtn" class="icon-button" type="button" aria-label="Open menu">☰</button>
      <div class="title-block">
        <strong>PI P25 Scanner</strong>
        <span id="dashboardSummary">Loading scanner state...</span>
      </div>
      <span id="connectionStatus" class="pill warn">Connecting</span>
    </header>

    <aside id="drawer" class="drawer" aria-hidden="true">
      <div class="drawer-head">
        <strong>Menu</strong>
        <button id="closeDrawerBtn" class="icon-button" type="button" aria-label="Close menu">×</button>
      </div>
      <button class="nav-item active" data-screen="dashboardScreen" type="button">Dashboard</button>
      <button class="nav-item" data-screen="wizardScreen" type="button">Radio Setup Wizard</button>
      <button class="nav-item" data-screen="configScreen" type="button">Local Config</button>
      <button class="nav-item" data-screen="logsScreen" type="button">Logs / Details</button>
      <div class="drawer-foot">
        <span id="lastUpdated">Last update: -</span>
      </div>
    </aside>
    <div id="drawerBackdrop" class="drawer-backdrop"></div>

    <main class="screen-frame">
      <section id="dashboardScreen" class="screen active" aria-label="dashboard">
        <div class="control-strip">
          <button id="startBtn" type="button" class="big-action start">Start Scanner + Audio</button>
          <button id="stopBtn" type="button" class="big-action stop">Stop</button>
        </div>

        <audio id="browserAudioPlayer" class="audio-player" controls preload="none"></audio>

        <section class="activity-card">
          <div class="activity-topline">
            <div>
              <span class="label">Active Talkgroup</span>
              <strong id="activeTalkgroupLabel">Waiting for activity</strong>
            </div>
            <span id="stateBadge" class="pill">-</span>
          </div>
          <div class="talkgroup-number" id="activeTgid">-</div>
          <div class="activity-grid">
            <div><span>Voice</span><strong id="voiceFrequency">-</strong></div>
            <div><span>Control</span><strong id="controlFrequency">-</strong></div>
            <div><span>Phase</span><strong id="p25Phase">-</strong></div>
            <div><span>Audio</span><strong id="browserAudioLastEvent">Ready</strong></div>
          </div>
        </section>

        <section class="stats-grid" aria-label="statistics">
          <article><span>State</span><strong id="scannerState">-</strong></article>
          <article><span>PID</span><strong id="decoderPid">-</strong></article>
          <article><span>Unique TGIDs</span><strong id="activityUniqueTgids">-</strong></article>
          <article><span>Clear</span><strong id="activityClearEvents">-</strong></article>
          <article><span>Encrypted</span><strong id="activityEncryptedEvents">-</strong></article>
          <article><span>Muted</span><strong id="activityMutedEvents">-</strong></article>
        </section>
      </section>

      <section id="wizardScreen" class="screen" aria-label="radio setup wizard">
        <div class="screen-title">
          <h1>Radio Setup Wizard</h1>
          <p>Build a local P25 config from the on-device catalog. Add more systems to <code>web/system_catalog.example.json</code> or a future imported catalog.</p>
        </div>
        <div class="wizard-grid">
          <label>State<input id="wizardState" type="text" value="AZ" autocomplete="off" inputmode="text"></label>
          <label>County<input id="wizardCounty" type="text" value="Maricopa" autocomplete="off"></label>
          <label>City<input id="wizardCity" type="text" value="Mesa" autocomplete="off"></label>
        </div>
        <div class="category-panel">
          <span class="label">Talkgroup Categories</span>
          <div id="categoryChoices" class="checkbox-grid"></div>
        </div>
        <div class="wizard-actions">
          <button id="findSystemsBtn" class="primary" type="button">Find Systems</button>
          <button id="applyWizardBtn" type="button">Apply Selected System</button>
        </div>
        <div class="wizard-results">
          <label>Matched Systems<select id="wizardSystemSelect" size="4"></select></label>
          <pre id="wizardPreview">No system selected.</pre>
        </div>
      </section>

      <section id="configScreen" class="screen" aria-label="configuration">
        <div class="screen-title">
          <h1>Local Config</h1>
          <p>Touch-friendly essentials. Advanced JSON remains available in the preview.</p>
        </div>
        <div class="config-actions">
          <button id="loadConfigBtn" type="button">Load</button>
          <button id="initLocalConfigBtn" type="button">Init Local</button>
          <button id="saveConfigBtn" type="button" class="primary">Save</button>
          <button id="generateConfigBtn" type="button">Generate OP25</button>
        </div>
        <form id="configForm" class="config-form">
          <label>System Name<input id="systemName" type="text" autocomplete="off"></label>
          <label>Site<input id="siteName" type="text" autocomplete="off"></label>
          <label>Control Channels MHz<textarea id="controlChannels" rows="4"></textarea></label>
          <label>Talkgroups: TGID, Label<textarea id="talkgroups" rows="5"></textarea></label>
          <label>Control SDR Serial<input id="controlSerial" type="text" autocomplete="off"></label>
          <label>Voice SDR Serial<input id="voiceSerial" type="text" autocomplete="off"></label>
          <label>RF Gain dB<input id="gainDb" type="number" step="0.1"></label>
          <label>PPM<input id="ppm" type="number" step="1"></label>
          <label class="check"><input id="phaseII" type="checkbox"> Phase II enabled</label>
          <label class="check"><input id="muteEncrypted" type="checkbox"> Mute encrypted calls</label>
        </form>
      </section>

      <section id="logsScreen" class="screen" aria-label="logs">
        <div class="screen-title">
          <h1>Logs / Details</h1>
          <p>Runtime detail for troubleshooting without crowding the touch dashboard.</p>
        </div>
        <div class="details-grid">
          <article><span>Launch Ready</span><strong id="launchReady">-</strong></article>
          <article><span>Command Source</span><strong id="commandSource">-</strong></article>
          <article><span>Marker</span><strong id="validatedMarkerState">-</strong></article>
          <article><span>OP25 HTTP</span><strong id="op25HttpListener">-</strong></article>
        </div>
        <details open>
          <summary>Recent Activity</summary>
          <pre id="activityRecentEvents">No parsed activity yet.</pre>
        </details>
        <details>
          <summary>Backend / OP25 Log Tail</summary>
          <pre id="logTail">No log lines yet.</pre>
        </details>
        <details>
          <summary>Active Config Preview</summary>
          <pre id="configPreview">Loading...</pre>
        </details>
        <details>
          <summary>Validated Command</summary>
          <pre id="validatedCommand">-</pre>
        </details>
        <pre id="lastEvent" class="last-event">Loading...</pre>
      </section>
    </main>
  </div>
  <script src="/app.js"></script>
</body>
</html>
