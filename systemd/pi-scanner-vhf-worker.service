[Unit]
Description=PI-SCANNER Isolated VHF Analog Scanner
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/n0jcg-scanner
Environment=PYTHONPATH=/home/pi/n0jcg-scanner/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m pi_p25_scanner.analog_vhf_worker --config /home/pi/n0jcg-scanner/runtime/settings/analog_receivers.json --status-path /home/pi/n0jcg-scanner/runtime/status/analog_2m.json
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
SuccessExitStatus=SIGINT SIGTERM 130
TimeoutStopSec=10
