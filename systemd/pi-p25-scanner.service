[Unit]
Description=N0JCG Scanner P25 backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/n0jcg-scanner
Environment=PYTHONPATH=/home/pi/n0jcg-scanner/src
Environment=PI_SCANNER_ANALOG_ROOT=/home/pi/n0jcg-scanner
ExecStart=/usr/bin/python3 -m pi_p25_scanner.backend --host 0.0.0.0 --port 8070
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
