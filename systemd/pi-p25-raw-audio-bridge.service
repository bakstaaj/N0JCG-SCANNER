[Unit]
Description=PI Scanner Unified P25 VHF UHF Audio Arbitrator
Wants=network-online.target
After=network-online.target pi-scanner-vhf-worker.service pi-scanner-uhf-worker.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/n0jcg-scanner
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/pi/n0jcg-scanner/tools/pi_scanner_audio_arbitrator.py --host 0.0.0.0 --port 8072 --listen-host 127.0.0.1 --p25-port 23456 --vhf-port 23458 --uhf-port 23459 --release-seconds 3.5 --warmup-frames 0 --prebuffer-frames 10 --max-queue-frames 150
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
