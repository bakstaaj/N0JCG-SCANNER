[Unit]
Description=PI-SCANNER Isolated UHF Analog Scanner
Wants=network-online.target pi-scanner-uhf-audio.service
After=network-online.target pi-scanner-uhf-audio.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/PI-SCANNER
Environment=PYTHONPATH=/home/pi/PI-SCANNER/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m pi_p25_scanner.analog_uhf_worker --config /home/pi/PI-SCANNER/runtime/settings/analog_receivers.json --template /home/pi/PI-SCANNER/config/analog_receivers.example.json --status-path /home/pi/PI-SCANNER/runtime/status/analog_70cm.json
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
